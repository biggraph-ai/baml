start: package_decl? import_decl* declaration*

package_decl: "package" qualified_name ";"
import_decl: "import" qualified_name ("as" NAME)? ";"

?declaration: attribute* class_decl
            | attribute* agent_decl
            | attribute* interface_decl
            | attribute* enum_decl
            | type_alias
            | provider_decl
            | graph_decl
            | policy_decl

attribute: "@" qualified_name ["(" [arguments] ")"]
modifier: "public" | "private" | "protected" | "internal" | "static" | "abstract" | "final" | "override" | "async"
class_decl: modifier* "class" NAME generic_params? class_bases? class_body
agent_decl: modifier* "agent" NAME generic_params? class_bases? class_body
class_bases: "extends" type_ref ["implements" type_list] | "implements" type_list
interface_decl: modifier* "interface" NAME generic_params? ["requires" type_list] interface_body
enum_decl: modifier* "enum" NAME "{" [NAME ("," NAME)* [","]] "}"
type_alias: "type" NAME generic_params? "=" type_ref ";"

class_body: "{" class_member* "}"
interface_body: "{" interface_member* "}"
?class_member: attribute* member_decl | instruction_decl
?interface_member: attribute* member_decl
member_decl: modifier* type_ref NAME (field_tail | method_tail)
field_tail: ["=" expression] ";"
method_tail: generic_params? parameters throws_clause? (block | inference_body | ";")
throws_clause: "throws" type_ref
parameters: "(" [parameter ("," parameter)*] ")"
parameter: type_ref NAME ["=" expression]
generic_params: "<" generic_param ("," generic_param)* ">"
generic_param: NAME ["extends" type_ref ("&" type_ref)*]

inference_body: "{" "provider" expression ";" ["capabilities" expression ";"] "instruction" INSTRUCTION_LITERAL ";" "}"
instruction_decl: "instruction" INSTRUCTION_LITERAL ";"
provider_decl: "provider" NAME ("=" expression ";" | provider_block)
provider_block: "{" provider_field* "}"
provider_field: NAME ":" expression ";"

graph_decl: "graph" NAME "(" NAME ":" type_ref ")" ["->" type_ref] "{" graph_member* "}"
?graph_member: "state" NAME ["=" expression] ";"                                      -> graph_state
             | "node" NAME "using" qualified_name node_contract* ";"                  -> graph_node
             | "start" "->" NAME ";"                                                  -> graph_start
             | NAME "->" graph_transition ";"                                         -> graph_edge
             | "invariant" expression ";"                                             -> graph_invariant
node_contract: "max_visits" INT | "timeout" expression | "compensate" "using" qualified_name
?graph_transition: "end"                                                               -> end_transition
                 | NAME                                                                -> target_transition
                 | "when" expression FAT_ARROW graph_target "otherwise" FAT_ARROW graph_target -> conditional_transition
?graph_target: "end" -> end_target | NAME -> name_target

policy_decl: "policy" NAME ["for" NAME] "{" policy_member* "}"
?policy_member: "invariant" expression ";"                                  -> policy_invariant
              | "rule" NAME ":" expression FAT_ARROW policy_effect ";"    -> policy_rule
?policy_effect: "end" | "throw" expression | NAME "(" [arguments] ")"

block: "{" statement* "}"
?statement: "let" NAME [":" type_ref] "=" expression ";"   -> let_stmt
          | "const" NAME [":" type_ref] "=" expression ";" -> const_stmt
          | "return" [expression] ";"                         -> return_stmt
          | "throw" expression ";"                            -> throw_stmt
          | expression ";"                                    -> expression_stmt

?expression: assignment
?assignment: coalesce | postfix ASSIGN_OP assignment -> binary
?coalesce: logic_or | coalesce "??" logic_or -> binary
?logic_or: logic_and | logic_or "||" logic_and -> binary
?logic_and: equality | logic_and "&&" equality -> binary
?equality: comparison | equality EQUALITY_OP comparison -> binary
?comparison: sum | comparison COMPARE_OP sum -> binary
?sum: product | sum ADD_OP product -> binary
?product: unary | product MUL_OP unary -> binary
?unary: ("!" | "~" | "-" | "await") unary -> unary | postfix
?postfix: atom
        | postfix "(" [arguments] ")" -> call
        | postfix "." NAME             -> member
        | postfix "[" expression "]"  -> index
?atom: literal | NAME -> name | "(" expression ")" | array | object
arguments: expression ("," expression)*
array: "[" [arguments] "]"
object: "new" qualified_name "{" [object_field ("," object_field)*] "}"
object_field: NAME ":" expression

?literal: STRING -> string | FLOAT -> float | INT -> integer | "true" -> true | "false" -> false | "null" -> null
?type_ref: union_type
?union_type: postfix_type | union_type "|" postfix_type -> union_type
?postfix_type: primary_type | postfix_type "[" "]" -> array_type | postfix_type "?" -> optional_type
primary_type: qualified_name ["<" type_list ">"]
type_list: type_ref ("," type_ref)*
qualified_name: NAME ("." NAME)*

ASSIGN_OP: "=" | "+=" | "-=" | "*=" | "/=" | "%="
FAT_ARROW.10: "=>"
EQUALITY_OP: "==" | "!="
COMPARE_OP: "<=" | ">=" | "<" | ">"
ADD_OP: "+" | "-"
MUL_OP: "*" | "/" | "%"
INSTRUCTION_LITERAL.10: /#"(?s:.*?)"#/
FLOAT: /[0-9]+\.[0-9]+/
INT: /[0-9]+/
NAME: /[^\W\d]\w*/
STRING: /"([^"\\]|\\.)*"/

LINE_COMMENT: /\/\/[^\n]*/
BLOCK_COMMENT: /\/\*(?s:.*?)\*\//
%ignore LINE_COMMENT
%ignore BLOCK_COMMENT
%import common.WS
%ignore WS
